# DB — local server (used when DATABASE_URL is not set, including `just run`)
DATABASE_USER=ws_lib_backend
DATABASE_PASSWORD=
DATABASE_PORT=5432
DATABASE_DOMAIN=localhost
DATABASE_NAME=ws_lib_metadata
DATABASE_SSL_MODE=disable

# Named environments for the justfile.
# `just export coolify` / `just push hetzner` resolve the corresponding URL.
# DATABASE_URL_LOCAL is optional — leave blank to compose from the vars above.
DATABASE_URL_LOCAL=
DATABASE_URL_COOLIFY=
DATABASE_URL_HETZNER=

# Coolify/Hetzner bootstrap (superuser URL, used by `just coolify-init`)
# Same instance as ws-backend — only the role + database differ.
POSTGRES_ADMIN_URL=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
BUCKET_NAME=wikisubmission
SQS_QUEUE_URL=

# CloudFront
CLOUDFRONT_DOMAIN=
CLOUDFRONT_BASE_URL=https://cdn.wikisubmission.org
CLOUDFRONT_PUBLIC_KEY_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=aws/private_key.pem

# API
TRUSTED_PROXIES=127.0.0.1,192.168.1.1
PORT=8082
GIN_MODE=release
APP_ENV=development
